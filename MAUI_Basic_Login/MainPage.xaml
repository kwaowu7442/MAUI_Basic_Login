<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Basic_Login.MainPage">

    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="Kwadwo Owusu" FontSize="24" HorizontalOptions="Center" />
        <Label Text="Login Screen" FontSize="20"
               FontAttributes="Bold,Italic" HorizontalOptions="Center" />

        <Label Text="User Name" />
        <Entry x:Name="UserNameEntry" />

        <Label Text="Password" />
        <Entry x:Name="PasswordEntry" IsPassword="True" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button Text="Login" Clicked="OnLoginClicked" />
            <Button Text="Cancel" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>

        <Label x:Name="MessageLabel" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
